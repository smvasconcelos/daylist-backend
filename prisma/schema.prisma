generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  name      String
  email     String   @unique
  password  String
  createdAt DateTime
  Note      Note[]
  Tag       Tag[]
}

model Note {
  id          String    @id
  title       String
  description String?
  createdAt   DateTime
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  tags        NoteTag[]
}

model Tag {
  id        String    @id
  title     String
  color     String
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime
  notes     NoteTag[]
}

model NoteTag {
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId String

  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId String

  @@id([noteId, tagId])
}
